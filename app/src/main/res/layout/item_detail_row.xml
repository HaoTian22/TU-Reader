<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/DetailRow"
    android:background="@drawable/bg_detail_row_divider">

    <TextView
        android:id="@+id/detailLabel"
        style="@style/DetailRowLabel"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:text="" />

    <!-- 进出站图标（FontAwesome，仅交易类型行使用） -->
    <TextView
        android:id="@+id/detailIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:layout_marginEnd="6dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/detailValue"
        style="@style/DetailRowValue"
        android:layout_width="wrap_content"
        android:layout_weight="0"
        android:text="" />
</LinearLayout>
