<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_content_card"
    android:elevation="8dp">

    <TextView
        android:id="@+id/dialogInputTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#1A1A1A"
        android:textSize="17sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="10dp" />

    <EditText
        android:id="@+id/dialogInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="请输入名称"
        android:textColor="#1A1A1A"
        android:textColorHint="#8E8E93"
        android:textSize="15sp"
        android:singleLine="true"
        android:inputType="text"
        android:background="@drawable/bg_chip_default"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#E5E5EA" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dialogInputCancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="取消"
            android:textColor="#555555"
            android:textSize="15sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="#E5E5EA" />

        <TextView
            android:id="@+id/dialogInputConfirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="保存"
            android:textColor="#0066FF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
