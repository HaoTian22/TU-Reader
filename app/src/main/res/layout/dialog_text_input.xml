<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="312dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog">

    <TextView
        android:id="@+id/dialogInputTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ink"
        android:textSize="20sp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:fontFamily="sans-serif-medium" />

    <EditText
        android:id="@+id/dialogInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="请输入名称"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink_3"
        android:textSize="15sp"
        android:singleLine="true"
        android:inputType="text"
        android:background="@drawable/bg_chip_default"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/dialogInputCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="取消"
            android:textColor="@color/ink_2"
            android:textSize="14sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:minWidth="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_text_button" />

        <TextView
            android:id="@+id/dialogInputConfirm"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="保存"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:minWidth="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_text_button" />
    </LinearLayout>
</LinearLayout>
