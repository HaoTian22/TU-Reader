<?xml version="1.0" encoding="utf-8"?>
<!-- 统计摘要：一张白卡三栏（总消费 / 乘车次数 / 日均消费），栏间竖分隔线 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="20dp"
    android:background="@drawable/bg_card_plain"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingTop="18dp"
    android:paddingBottom="18dp">

    <LinearLayout style="@style/StatsSummaryCell">

        <TextView
            style="@style/StatsSummaryLabel"
            android:text="@string/stats_total_spending" />

        <TextView
            android:id="@+id/sumTotalSpending"
            style="@style/StatsSummaryValue"
            android:text="¥0.00" />
    </LinearLayout>

    <View style="@style/StatsSummaryDivider" />

    <LinearLayout style="@style/StatsSummaryCell">

        <TextView
            style="@style/StatsSummaryLabel"
            android:text="@string/stats_ride_count" />

        <TextView
            android:id="@+id/sumRideCount"
            style="@style/StatsSummaryValue"
            tools:text="0 次" />
    </LinearLayout>

    <View style="@style/StatsSummaryDivider" />

    <LinearLayout style="@style/StatsSummaryCell">

        <TextView
            style="@style/StatsSummaryLabel"
            android:text="@string/stats_daily_avg" />

        <TextView
            android:id="@+id/sumAvgDaily"
            style="@style/StatsSummaryValue"
            android:text="¥0.00" />
    </LinearLayout>
</LinearLayout>
