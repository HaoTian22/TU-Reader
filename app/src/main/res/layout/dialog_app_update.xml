<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="312dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog">

    <TextView
        android:id="@+id/updateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp"
        android:text="@string/app_update_available"
        android:textColor="@color/ink"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/updateVersions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:textColor="@color/ink_3"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp" />

    <TextView
        android:id="@+id/updateTestingNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:text="@string/app_update_testing_notice"
        android:textColor="@color/ink_2"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/updateNotesScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false">
        <TextView
            android:id="@+id/updateNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_2"
            android:textSize="14sp"
            android:textIsSelectable="true"
            android:lineSpacingExtra="3dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">
        <TextView
            android:id="@+id/updateCancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center"
            android:text="@string/update_later"
            android:textColor="@color/ink_2"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_text_button"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/updateDownload"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center"
            android:text="@string/download_apk"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_text_button"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
