<?xml version="1.0" encoding="utf-8"?>
<!--
  卡片信息页。版式与交易详情页一致：左右 20dp、分区标题在卡片外、卡片内为标签/值行。
  结构：摘要（卡面 + 名称 + 类型·城市 + 余额 + 上次读取）→ 个性化 → 卡片信息 → 有效期 → 原始数据
  分区内行间分隔线由代码按可见行设置（第二标准/第二卡号行可能隐藏）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/status_bar_spacer_height" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="11dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/btnBack"
            style="@style/BackButton"
            android:text="←"
            android:textColor="@color/accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/card_info_title"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/cardBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_badge"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvCardBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="140dp"
                android:maxLines="1"
                android:text="@string/home_cards_label"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- 摘要 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_card_plain"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 迷你卡面：卡片主题渐变，代码设置 -->
                    <View
                        android:id="@+id/heroCardFace"
                        android:layout_width="56dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_card_badge" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCardName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="2"
                            android:text="@string/card_info_name"
                            android:textColor="@color/ink"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/tvHeroSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/ink_3"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/line" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_current_balance"
                    android:textColor="@color/ink_3"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="¥0.00"
                    android:textColor="@color/ink"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLastRead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="—"
                    android:textColor="@color/ink_3"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 个性化：整行可点 -->
            <TextView
                style="@style/DetailSectionTitle"
                android:text="@string/card_info_personalize" />

            <LinearLayout style="@style/DetailSectionCard">

                <LinearLayout
                    android:id="@+id/rowEditName"
                    style="@style/DetailRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/DetailRowLabel"
                        android:text="@string/card_info_name" />

                    <TextView
                        android:id="@+id/tvNameValue"
                        style="@style/DetailRowValue"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/btnEditName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:tag="fa"
                        android:text="&#xf044;"
                        android:textColor="@color/accent"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_marginStart="16dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/rowChangeColor"
                    style="@style/DetailRow"
                    android:clickable="true"
                    android:contentDescription="@string/card_info_change_color_cd"
                    android:focusable="true">

                    <TextView
                        style="@style/DetailRowLabel"
                        android:text="@string/card_info_color" />

                    <TextView
                        android:id="@+id/tvColorName"
                        style="@style/DetailRowValue" />

                    <View
                        android:id="@+id/cardColorPreview"
                        android:layout_width="28dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_card_badge" />

                    <TextView
                        android:id="@+id/btnChangeColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:tag="fa"
                        android:text="&#xf054;"
                        android:textColor="@color/ink_3"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 卡片信息 -->
            <TextView
                style="@style/DetailSectionTitle"
                android:text="@string/card_info_title" />

            <LinearLayout
                android:id="@+id/sectionCardInfo"
                style="@style/DetailSectionCard">

                <LinearLayout style="@style/DetailRow">

                    <TextView
                        style="@style/DetailRowLabel"
                        android:text="@string/card_info_number" />

                    <TextView
                        android:id="@+id/tvCardNumber"
                        style="@style/DetailRowValue"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/secondCardNumberRow"
                    style="@style/DetailRow">

                    <TextView
                        style="@style/DetailRowLabel"
                        android:text="@string/card_info_second_number" />

                    <TextView
                        android:id="@+id/tvSecondCardNumber"
                        style="@style/DetailRowValue"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true" />
                </LinearLayout>

                <LinearLayout style="@style/DetailRow">

                    <TextView
                        style="@style/DetailRowLabel"
                        android:text="@string/card_info_type" />

                    <TextView
                        android:id="@+id/tvCardType"
                        style="@style/DetailRowValue" />
                </LinearLayout>

                <LinearLayout style="@style/DetailRow">

                    <TextView
                        style="@style/DetailRowLabel"
                        android:text="@string/card_info_issuer_city" />

                    <TextView
                        android:id="@+id/tvIssuerCity"
                        style="@style/DetailRowValue" />
                </LinearLayout>

                <LinearLayout style="@style/DetailRow">

                    <TextView
                        style="@style/DetailRowLabel"
                        android:text="@string/card_info_issuer" />

                    <TextView
                        android:id="@+id/tvIssuer"
                        style="@style/DetailRowValue" />
                </LinearLayout>
            </LinearLayout>

            <!-- 有效期 -->
            <TextView
                style="@style/DetailSectionTitle"
                android:text="@string/card_info_validity" />

            <LinearLayout
                android:id="@+id/sectionValidity"
                style="@style/DetailSectionCard">

                <LinearLayout style="@style/DetailRow">

                    <TextView
                        style="@style/DetailRowLabel"
                        android:text="@string/card_info_issue_date" />

                    <TextView
                        android:id="@+id/tvIssueDate"
                        style="@style/DetailRowValue" />
                </LinearLayout>

                <LinearLayout style="@style/DetailRow">

                    <TextView
                        style="@style/DetailRowLabel"
                        android:text="@string/card_info_valid_until" />

                    <TextView
                        android:id="@+id/tvValidUntil"
                        style="@style/DetailRowValue" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/secondStandardIssueRow"
                    style="@style/DetailRow"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvSecondIssueLabel"
                        style="@style/DetailRowLabel"
                        tools:text="第二标准发行日期" />

                    <TextView
                        android:id="@+id/tvSecondIssueDate"
                        style="@style/DetailRowValue" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/secondStandardValidRow"
                    style="@style/DetailRow"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvSecondValidLabel"
                        style="@style/DetailRowLabel"
                        tools:text="第二标准有效期至" />

                    <TextView
                        android:id="@+id/tvSecondValidUntil"
                        style="@style/DetailRowValue" />
                </LinearLayout>
            </LinearLayout>

            <!-- 原始数据 -->
            <LinearLayout
                android:id="@+id/rawDataSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/label_raw_data"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnCopyRawData"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_text_button"
                        android:clickable="true"
                        android:contentDescription="@string/card_info_copy_raw_cd"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/action_copy"
                        android:textColor="@color/accent"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rawDataPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_hex_panel"
                    android:orientation="vertical"
                    android:padding="16dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
