<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_txn_row"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_marginTop="4dp"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_icon_circle_blue">

        <TextView
            android:id="@+id/txnIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="🚇"
            android:textSize="16sp"
            android:gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <!-- 药丸列表：城市/类型/线路，任一放不下就整个换行（FlowLayout 自动 wrap） -->
        <com.example.nfctransit.ui.FlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txnCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="广州"
                android:textColor="#555555"
                android:textSize="10sp"
                android:singleLine="true"
                android:background="@drawable/bg_chip_default"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/txnType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="地铁"
                android:textColor="#555555"
                android:textSize="10sp"
                android:singleLine="true"
                android:background="@drawable/bg_chip_default"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/txnLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1号线"
                android:textColor="#555555"
                android:textSize="10sp"
                android:singleLine="true"
                android:background="@drawable/bg_chip_default"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone" />
        </com.example.nfctransit.ui.FlowLayout>

        <!-- 第二行：出入站图标 + 站名 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/txnDirIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:layout_marginEnd="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txnStation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="体育中心"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="200dp" />
        </LinearLayout>

        <!-- 第三行：时间 -->
        <TextView
            android:id="@+id/txnTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09-15 08:23"
            android:textColor="#8E8E93"
            android:textSize="10sp"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/txnAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-¥3.00"
            android:textColor="#FF3B30"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/txnBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="余额 ¥45.50"
            android:textColor="#8E8E93"
            android:textSize="11sp" />

        <!-- 协议药丸：该记录被哪些协议写入（LNT/TU），最多两个；空则隐藏 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/txnProtocol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TU"
                android:textColor="#555555"
                android:textSize="8sp"
                android:background="@drawable/bg_chip_default"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txnProtocol2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LNT"
                android:textColor="#555555"
                android:textSize="8sp"
                android:background="@drawable/bg_chip_default"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:layout_marginStart="4dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
