<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_txn_row"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_marginTop="4dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_circle_blue">

            <TextView
                android:id="@+id/txnIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="🚇"
                android:textSize="16sp"
                android:gravity="center" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txnDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="地铁2号线 人民广场站"
                    android:textColor="#1A1A1A"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <!-- 进出站图标（FontAwesome，跟在站名后面） -->
                <TextView
                    android:id="@+id/txnDirIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:layout_marginStart="4dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/txnTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2024-09-15 08:23:15"
                android:textColor="#8E8E93"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/txnAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-¥3.00"
            android:textColor="#FF3B30"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/txnBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="余额 ¥45.50"
            android:textColor="#8E8E93"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
