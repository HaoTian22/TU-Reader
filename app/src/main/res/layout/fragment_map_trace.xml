<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <!-- Status Bar Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/status_bar_spacer_height" />

    <!-- Nav Header (常驻置顶)：与统计/交易页一致——主题色返回、深色标题、主题淡色卡片徽章 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="11dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnBack"
            style="@style/BackButton"
            android:text="←"
            android:textColor="@color/accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/map_trace"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/cardBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_badge"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvCardBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="深圳通 · 3821"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxWidth="140dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- 地图卡片（圆角裁切需 TextureMapView；不放进 ScrollView 以免手势冲突） -->
    <FrameLayout
        android:id="@+id/mapCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card_plain">

        <com.tencent.tencentmap.mapsdk.maps.TextureMapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 左上角：右下角是腾讯地图 logo -->
        <TextView
            android:id="@+id/tvMapHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_map_hint"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="@string/map_hint_default"
            android:textColor="@color/ink_2"
            android:textSize="11sp" />
    </FrameLayout>

    <!-- Playback 卡片：当前站点 + 进度 + 播放控件 + 速度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_plain"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <!-- 当前站点/线段（站名 + 药丸线路） -->
        <LinearLayout
            android:id="@+id/currentStationPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <com.example.nfctransit.ui.RouteFlowLayout
                android:id="@+id/currentStationRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/ink_3"
                android:textSize="11sp"
                android:paddingTop="3dp" />
        </LinearLayout>

        <!-- Progress Bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="4dp">
            <View
                android:id="@+id/progressTrack"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="@drawable/bg_progress_track" />
            <View
                android:id="@+id/progressPlayback"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:background="@color/accent" />
        </FrameLayout>

        <!-- Play Controls + 速度（最右） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp">

            <TextView
                android:id="@+id/btnPrev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏮"
                android:textColor="@color/ink_2"
                android:textSize="18sp"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:paddingEnd="16dp" />

            <TextView
                android:id="@+id/btnPlay"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_play_button"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏭"
                android:textColor="@color/ink_2"
                android:textSize="18sp"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:paddingStart="16dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/chip05x"
                style="@style/MapSpeedChip"
                android:layout_marginEnd="6dp"
                android:text="0.5x" />

            <TextView
                android:id="@+id/chip1x"
                style="@style/MapSpeedChip"
                android:layout_marginEnd="6dp"
                android:text="1x" />

            <TextView
                android:id="@+id/chip2x"
                style="@style/MapSpeedChip"
                android:text="2x" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/SettingsSectionTitle"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:text="@string/trip_info" />

    <!-- Trip Info 卡片（可滑动调时间） -->
    <ScrollView
        android:id="@+id/tripScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card_plain"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tripListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp" />
    </ScrollView>
</LinearLayout>
