<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

        <!-- Status Bar Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- Nav Header (常驻置顶) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="#0066FF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="设置"
                android:textColor="#1A1A1A"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Scrollable content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F8F9FA">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

        <!-- Settings Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Section: 卡片管理 -->
            <include layout="@layout/section_card_management" />

            <!-- Copy NFC Data Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_content_card"
                android:layout_marginBottom="24dp"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="调试工具"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/btnCopyData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📋 复制所有读取数据"
                    android:textColor="#0066FF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_selected"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/btnCopyLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📋 复制 APDU 日志"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_default"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvCopyStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#34C759"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Section: 数据与隐私 -->
            <include layout="@layout/section_data_privacy" />

            <!-- Section: 显示与体验 -->
            <include layout="@layout/section_display" />

            <!-- Section: 关于 -->
            <include layout="@layout/section_about" />
            </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

