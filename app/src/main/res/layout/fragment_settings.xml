<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

        <!-- Status Bar Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/status_bar_spacer_height" />

        <!-- Nav Header (常驻置顶) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBack"
                style="@style/BackButton"
                android:text="←"
                android:textColor="@color/accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Scrollable content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/paper">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

        <!-- Settings Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Section: 卡片管理 -->
            <include layout="@layout/section_card_management" />

            <!-- Section: 数据与隐私 -->
            <include layout="@layout/section_data_privacy" />

            <!-- Section: 显示与体验 -->
            <include layout="@layout/section_display" />

            <!-- Section: 调试工具 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingsSectionTitle"
                    android:text="@string/settings_debug_tools" />

                <LinearLayout style="@style/SettingsSectionCard">

                    <LinearLayout
                        android:id="@+id/rowExportData"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/iconExportData"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_settings_icon"
                            android:gravity="center"
                            android:text="&#xf56e;"
                            android:textColor="@color/accent"
                            android:textSize="14sp"
                            android:tag="fa" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_export_read_data"
                            android:textColor="@color/ink"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&#xf054;"
                            android:textColor="@color/ink_3"
                            android:textSize="14sp"
                            android:tag="fa" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowExportLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/iconExportLog"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_settings_icon"
                            android:gravity="center"
                            android:text="&#xf120;"
                            android:textColor="@color/accent"
                            android:textSize="14sp"
                            android:tag="fa" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_export_apdu"
                            android:textColor="@color/ink"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&#xf054;"
                            android:textColor="@color/ink_3"
                            android:textSize="14sp"
                            android:tag="fa" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:id="@+id/iconDebugLog"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_settings_icon"
                            android:gravity="center"
                            android:text="&#xf188;"
                            android:textColor="@color/accent"
                            android:textSize="14sp"
                            android:tag="fa" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_keep_debug_log"
                            android:textColor="@color/ink"
                            android:textSize="14sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchKeepDebugLogs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="0dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCopyStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/success"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section: 关于 -->
            <include layout="@layout/section_about" />
            </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
