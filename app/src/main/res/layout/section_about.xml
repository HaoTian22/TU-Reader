<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp">

    <LinearLayout style="@style/SettingsSectionCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/brand_lockup"
                android:textColor="@color/ink_3"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/SettingsSectionTitle"
        android:text="关于" />

    <LinearLayout style="@style/SettingsSectionCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/iconVersion"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_settings_icon"
                android:gravity="center"
                android:text="&#xf02b;"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:tag="fa" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="版本号"
                android:textColor="@color/ink"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_version"
                android:textColor="@color/ink_3"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowCheckUpdate"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/iconCheckUpdate"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_settings_icon"
                android:gravity="center"
                android:text="&#xf2f1;"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:tag="fa" />

            <TextView
                android:id="@+id/tvCheckUpdate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/check_for_updates"
                android:textColor="@color/ink"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/chevronCheckUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#xf054;"
                android:textColor="@color/ink_3"
                android:textSize="14sp"
                android:tag="fa" />
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressCheckUpdate"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorSize="18dp"
                app:trackThickness="2dp"
                app:indicatorColor="@color/accent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/iconSupportedCards"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_settings_icon"
                android:gravity="center"
                android:text="&#xf0ae;"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:tag="fa" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="支持的卡种列表"
                android:textColor="@color/ink"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#xf054;"
                android:textColor="@color/ink_3"
                android:textSize="14sp"
                android:tag="fa" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/iconOpenSource"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_settings_icon"
                android:gravity="center"
                android:text="&#xf004;"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:tag="fa" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="开源致谢"
                android:textColor="@color/ink"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#xf054;"
                android:textColor="@color/ink_3"
                android:textSize="14sp"
                android:tag="fa" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconFeedback"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_settings_icon"
                android:gravity="center"
                android:text="&#xf0e0;"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:tag="fa" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="反馈入口"
                android:textColor="@color/ink"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#xf0c1;"
                android:textColor="@color/ink_3"
                android:textSize="14sp"
                android:tag="fa" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
