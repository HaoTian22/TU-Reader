<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_content_card"
    android:divider="@drawable/bg_row_divider"
    android:showDividers="middle"
    android:layout_marginBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="数据与隐私"
        android:textColor="#8E8E93"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/iconLocalStorage"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center"
            android:text="&#xf1c0;"
            android:textColor="#0066FF"
            android:textSize="14sp"
            android:tag="fa" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="本地数据存储"
            android:textColor="#1A1A1A"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tvLocalStorageValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#8E8E93"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowDataExport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/iconDataExport"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center"
            android:text="&#xf019;"
            android:textColor="#0066FF"
            android:textSize="14sp"
            android:tag="fa" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="数据导出 (CSV/JSON/DB)"
            android:textColor="#1A1A1A"
            android:textSize="14sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#xf054;"
            android:textColor="#8E8E93"
            android:textSize="14sp"
            android:tag="fa" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowImportData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/iconImportData"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:text="&#xf56f;"
                android:textColor="#0066FF"
                android:textSize="14sp"
                android:tag="fa" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="导入数据库 (DB / TripReader)"
                android:textColor="#1A1A1A"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/chevronImportData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#xf054;"
                android:textColor="#8E8E93"
                android:textSize="14sp"
                android:tag="fa" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvImportDataStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#34C759"
            android:textSize="11sp"
            android:paddingStart="30dp"
            android:paddingTop="4dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowClearData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/iconClearData"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center"
            android:text="&#xf2ed;"
            android:textColor="#0066FF"
            android:textSize="14sp"
            android:tag="fa" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="清除全部本地数据"
            android:textColor="#FF3B30"
            android:textSize="14sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#xf054;"
            android:textColor="#8E8E93"
            android:textSize="14sp"
            android:tag="fa" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/iconPrivacy"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center"
            android:text="&#xf3ed;"
            android:textColor="#0066FF"
            android:textSize="14sp"
            android:tag="fa" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="隐私说明"
            android:textColor="#1A1A1A"
            android:textSize="14sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#xf054;"
            android:textColor="#8E8E93"
            android:textSize="14sp"
            android:tag="fa" />
    </LinearLayout>
</LinearLayout>
