<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/SettingsSectionTitle"
        android:text="数据与隐私" />

    <LinearLayout style="@style/SettingsSectionCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/iconLocalStorage"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_settings_icon"
                android:gravity="center"
                android:text="&#xf1c0;"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:tag="fa" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="本地数据存储"
                android:textColor="@color/ink"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tvLocalStorageValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/ink_3"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowDatabaseViewer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconDatabaseViewer"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_settings_icon"
                android:gravity="center"
                android:text="&#xf1c0;"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:tag="fa" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="查看数据库"
                android:textColor="@color/ink"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#xf054;"
                android:textColor="@color/ink_3"
                android:textSize="14sp"
                android:tag="fa" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowTransitOverrides"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconTransitOverrides"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_settings_icon"
                android:gravity="center"
                android:text="&#xf044;"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:tag="fa" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="管理本地映射数据"
                android:textColor="@color/ink"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#xf054;"
                android:textColor="@color/ink_3"
                android:textSize="14sp"
                android:tag="fa" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowDataExport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconDataExport"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_settings_icon"
                android:gravity="center"
                android:text="&#xf019;"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:tag="fa" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="数据导出 (CSV/JSON/DB)"
                android:textColor="@color/ink"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#xf054;"
                android:textColor="@color/ink_3"
                android:textSize="14sp"
                android:tag="fa" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowImportData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/iconImportData"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_settings_icon"
                    android:gravity="center"
                    android:text="&#xf56f;"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:tag="fa" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="导入备份数据库"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/chevronImportData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#xf054;"
                    android:textColor="@color/ink_3"
                    android:textSize="14sp"
                    android:tag="fa" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvImportDataStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/success"
                android:textSize="11sp"
                android:paddingStart="30dp"
                android:paddingTop="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowClearCache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/iconClearCache"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_settings_icon"
                    android:gravity="center"
                    android:text="&#xf51a;"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:tag="fa" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="清理缓存"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
                <!-- 右侧状态：箭头 / 清理中进度环 / 成功 ✓ / 失败 ⚠（同一位置切换，与「站名映射表更新」一致） -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="24dp">

                    <TextView
                        android:id="@+id/chevronClearCache"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:text="&#xf054;"
                        android:textColor="@color/ink_3"
                        android:textSize="14sp"
                        android:tag="fa" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressClearCache"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorSize="22dp"
                        app:trackThickness="2.5dp"
                        app:trackCornerRadius="2dp"
                        app:trackColor="@color/fill" />
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowClearData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconClearData"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_settings_icon"
                android:gravity="center"
                android:text="&#xf2ed;"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:tag="fa" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="清除全部本地数据"
                android:textColor="@color/danger"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#xf054;"
                android:textColor="@color/ink_3"
                android:textSize="14sp"
                android:tag="fa" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
