<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="312dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog">

    <TextView
        android:id="@+id/dialogReorderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/card_sorting"
        android:textColor="@color/ink"
        android:textSize="20sp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:fontFamily="sans-serif-medium" />

    <!-- 行高 52dp；超过 300dp 时由代码限高并滚动 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dialogReorderList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="vertical"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/dialogReorderCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/action_cancel"
            android:textColor="@color/ink_2"
            android:textSize="14sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:minWidth="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_text_button" />

        <TextView
            android:id="@+id/dialogReorderDone"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/action_done"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:minWidth="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_text_button" />
    </LinearLayout>
</LinearLayout>
