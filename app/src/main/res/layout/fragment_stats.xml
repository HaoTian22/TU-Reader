<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

        <!-- Status Bar Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/status_bar_spacer_height" />

        <!-- Nav Header (常驻置顶) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBack"
                style="@style/BackButton"
                android:text="←"
                android:textColor="@color/accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="数据统计"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cardBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tvCardBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="深圳通 · 3821"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxWidth="140dp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- 周期切换（固定在顶部，不随内容滚动）：等宽胶囊，选中态由代码按主题色填充 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/paper"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/segWeek"
                style="@style/StatsPeriodChip"
                android:text="本周" />

            <TextView
                android:id="@+id/segMonth"
                style="@style/StatsPeriodChip"
                android:layout_marginStart="8dp"
                android:text="本月" />

            <TextView
                android:id="@+id/segYear"
                style="@style/StatsPeriodChip"
                android:layout_marginStart="8dp"
                android:text="本年" />

            <TextView
                android:id="@+id/segCustom"
                style="@style/StatsPeriodChip"
                android:layout_marginStart="8dp"
                android:text="自定义" />
        </LinearLayout>

        <!-- 周期导航（固定在顶部，作用于下方全部统计）：上一期 | 日期范围（+ 回到当前） | 下一期；自定义周期下隐藏 -->
        <LinearLayout
            android:id="@+id/periodNavRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/btnPrevPeriod"
                style="@style/StatsNavButton"
                android:contentDescription="上一期"
                android:text="&#xF053;" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPeriodRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />

                <!-- 回到当前周期（非当前期时显示） -->
                <TextView
                    android:id="@+id/btnBackCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_nav_circle"
                    android:clickable="true"
                    android:contentDescription="回到当前周期"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="&#xF2EA; 当前"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnNextPeriod"
                style="@style/StatsNavButton"
                android:contentDescription="下一期"
                android:text="&#xF054;" />
        </LinearLayout>

        <!-- 自定义日期范围行（仅自定义周期可见）：起止两个可点选日期 -->
        <LinearLayout
            android:id="@+id/customRangeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCustomStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_default"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="开始日期"
                android:textColor="@color/ink_2"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="至"
                android:textColor="@color/ink_3"
                android:textSize="13sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <TextView
                android:id="@+id/tvCustomEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_default"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="结束日期"
                android:textColor="@color/ink_2"
                android:textSize="13sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvCustomRangeHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点击选择日期"
                android:textColor="@color/ink_3"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Scrollable content -->
        <ScrollView
            android:id="@+id/rootScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/paper">

            <LinearLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

        <!-- 统计内容：摘要 → 消费趋势 → 分类 / 城市 → 常去车站 / 常坐线路；分区标题在卡片外（同详情页） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <include android:id="@+id/cardSummary" layout="@layout/card_stats_summary" />

            <TextView
                style="@style/DetailSectionTitle"
                android:text="消费趋势" />

            <include android:id="@+id/cardTrend" layout="@layout/card_spending_trend" />

            <TextView
                style="@style/DetailSectionTitle"
                android:text="分类开销" />

            <include android:id="@+id/cardCategories" layout="@layout/card_spending_categories" />

            <TextView
                style="@style/DetailSectionTitle"
                android:text="城市开销" />

            <include android:id="@+id/cardCities" layout="@layout/card_spending_cities" />

            <TextView
                style="@style/DetailSectionTitle"
                android:text="常去车站 · Top 5" />

            <include android:id="@+id/cardStations" layout="@layout/card_top_stations" />

            <TextView
                style="@style/DetailSectionTitle"
                android:text="常坐线路 · Top 5" />

            <include android:id="@+id/cardLines" layout="@layout/card_top_lines" />
            </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

