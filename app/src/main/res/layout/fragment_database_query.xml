<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/status_bar_spacer_height" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="11dp"
        android:paddingEnd="20dp"
        android:paddingTop="@dimen/nav_header_padding_top"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/btnBack"
            style="@style/BackButton"
            android:text="←"
            android:textColor="@color/accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDatabaseTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/db_query_title"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 分区与交易详情页一致：标题在卡片外，白色无描边圆角卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- 提示词 + SQL 合并为一张紧凑卡片（行间分隔线同设置页），把空间留给结果表格 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_plain"
            android:divider="@drawable/bg_db_card_divider"
            android:showDividers="middle">

            <!-- 提示词行：点击展开/收起完整提示词 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/iconPrompt"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_settings_icon"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/accent"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPromptTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/db_section_prompt"
                            android:textColor="@color/ink"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@string/db_query_instructions"
                            android:textColor="@color/ink_3"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnCopyPrompt"
                        style="@style/DbQueryHeaderAction"
                        android:layout_marginStart="8dp"
                        android:text="@string/action_copy" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/promptPanel"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_hex_panel"
                    android:fadeScrollbars="false"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/night_ink"
                        android:textSize="11sp"
                        android:textIsSelectable="true" />
                </ScrollView>
            </LinearLayout>

            <!-- SQL 行：点击预览框编辑，剪贴板按钮一键替换，右侧运行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvSqlPreview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="@string/db_query_no_sql"
                    android:textColor="@color/ink_3"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_db_sql_box"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnPasteSql"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:contentDescription="@string/db_paste_clipboard"
                    android:textColor="@color/accent"
                    android:textSize="15sp"
                    android:background="@drawable/bg_db_sql_box"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnRunSql"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/action_run"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_selected"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- 查询结果：状态（行数 / 进行中 / 错误）放在分区标题右侧 -->
        <LinearLayout
            style="@style/DbQuerySectionHeader"
            android:layout_marginTop="16dp">

            <TextView
                style="@style/DbQuerySectionTitle"
                android:text="@string/db_section_results" />

            <TextView
                android:id="@+id/tvQueryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:maxWidth="240dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:gravity="end"
                android:textColor="@color/ink_3"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/resultsCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="140dp"
            android:background="@drawable/bg_card_plain">

            <!-- 结果网格：表头固定在顶部，数据行用 RecyclerView 虚拟化（只创建可见行），
                 列宽在后台预先算好后整体设定，避免大结果集一次性创建/测量上千个单元格 -->
            <HorizontalScrollView
                android:id="@+id/resultsHScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="horizontal">

                <LinearLayout
                    android:id="@+id/resultsGrid"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/resultsHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/resultsList"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:scrollbars="vertical" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/resultsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:id="@+id/tvResultsEmptyIcon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_icon_circle"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textColor="@color/ink_3"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvResultsEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/db_query_results_placeholder"
                    android:textColor="@color/ink_2"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvResultsEmptyDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:maxLines="4"
                    android:ellipsize="end"
                    android:textColor="@color/ink_3"
                    android:textSize="12sp"
                    android:textIsSelectable="true"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
