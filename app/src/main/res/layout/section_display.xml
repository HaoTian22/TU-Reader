<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/SettingsSectionTitle"
        android:text="@string/display_and_experience" />

    <LinearLayout style="@style/SettingsSectionCard">

        <!-- 深色模式尚未实现：整行置灰（半透明）且开关不可操作 -->
        <LinearLayout
            android:id="@+id/rowDarkMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:alpha="0.4">

            <TextView
                android:id="@+id/iconDarkMode"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_settings_icon"
                android:gravity="center"
                android:text="&#xf186;"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:tag="fa" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dark_mode"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchDarkMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:enabled="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowCurrentTripRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconCurrentTripRoute"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_settings_icon"
                android:gravity="center"
                android:text="&#xf4d7;"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:tag="fa" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/current_trip_route"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvCurrentTripRouteValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="仅起终点"
                android:textColor="@color/ink_3"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/iconMapSpeed"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_settings_icon"
                android:gravity="center"
                android:text="&#xf5a0;"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:tag="fa" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/map_animation_speed"
                android:textColor="@color/ink"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#xf054;"
                android:textColor="@color/ink_3"
                android:textSize="14sp"
                android:tag="fa" />
        </LinearLayout>

        <!-- 轨迹回放时在起飞/到站等节点给出轻柔触感 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/iconPlaybackHaptics"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_settings_icon"
                android:gravity="center"
                android:text="&#xf3cd;"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:tag="fa" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/playback_haptics"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchPlaybackHaptics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconLanguage"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_settings_icon"
                android:gravity="center"
                android:text="&#xf1ab;"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:tag="fa" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/language_switch"
                android:textColor="@color/ink"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tvLanguageValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="中文"
                android:textColor="@color/ink_3"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
