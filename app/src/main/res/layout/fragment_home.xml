<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <!-- Loading State: shown while restore() rebuilds caches / loads card data -->
    <LinearLayout
        android:id="@+id/loadingState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在加载数据…"
            android:textColor="@color/ink_3"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- Empty State: shown when no card data -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/brand_english_name"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="@string/app_slogan"
            android:textColor="@color/ink_3"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:padding="32dp"
            android:src="@drawable/ic_nfc"
            android:background="@drawable/bg_action_circle"
            android:importantForAccessibility="no"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="请将手机背面靠近交通卡"
            android:textColor="@color/ink_3"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="支持 交通联合卡 · 深圳通 · 岭南通 · 城市一卡通"
            android:textColor="@color/ink_disabled"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="已有历史数据？"
            android:textColor="@color/ink_3"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnImportOldData"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_import_old_data_button"
            android:enabled="true"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="导入旧数据"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="导入数据库备份"
            android:textColor="@color/ink_disabled"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvImportOldDataStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:textColor="@color/ink_3"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Content: 卡包 —— 标题 + 总余额/卡片数 + 叠放卡片 + 贴卡读取新卡片 -->
    <LinearLayout
        android:id="@+id/contentWrapper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/paper"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/status_bar_spacer_height" />

        <!-- 固定头部：标题 + 设置 + 总余额/卡片数（不随卡片滚动） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- 标题 + 设置 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="我的卡片"
                    android:textColor="@color/ink"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSettings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_action_circle"
                    android:clickable="true"
                    android:contentDescription="设置"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="&#xF013;"
                    android:textColor="@color/ink_2"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 总余额 / 卡片数 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="总余额"
                        android:textColor="@color/ink_3"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTotalBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/ink"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="卡片"
                        android:textColor="@color/ink_3"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvCardCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/ink"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 卡片区：仅此区域滚动；底部渐隐遮罩让下方卡片看起来逐渐显现 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/contentScroll"
                android:requiresFadingEdge="none"
                android:fadingEdgeLength="0dp"
                android:descendantFocusability="afterDescendants"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="96dp">

                    <!-- 叠放卡片：由代码按卡片顺序生成，后面的卡压在前面的卡上，最后一张完整展示 -->
                    <FrameLayout
                        android:id="@+id/cardStack"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <!-- 贴卡读取新卡片（NFC 为被动触发，点击仅给出操作提示） -->
                    <TextView
                        android:id="@+id/btnAddCard"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="28dp"
                        android:background="@drawable/bg_dashed_add"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="+  贴卡读取新卡片"
                        android:textColor="@color/ink_2"
                        android:textSize="15sp" />
                </LinearLayout>
            </ScrollView>

            <View
                android:id="@+id/bottomFade"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_bottom_fade" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
