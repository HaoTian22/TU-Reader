<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogSqlContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_content_card">

    <TextView
        android:id="@+id/dialogSqlTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="粘贴 SQL 查询"
        android:textColor="#1A1A1A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/dialogSqlInput"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:minHeight="140dp"
        android:gravity="top|start"
        android:hint="在这里粘贴 AI 生成的 SELECT SQL"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical"
        android:textColor="#1A1A1A"
        android:textColorHint="#8E8E93"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:padding="10dp"
        android:background="@drawable/bg_chip_default" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp">

        <TextView
            android:id="@+id/dialogSqlCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="取消"
            android:textColor="#8E8E93"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/dialogSqlConfirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="确定"
            android:textColor="#0066FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
