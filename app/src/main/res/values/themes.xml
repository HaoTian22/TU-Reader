<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TransitU" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 文本选中手柄：套用 appcompat 手柄轮廓，着色为 MD3 主色，取代原生蓝灰 -->
        <item name="android:textSelectHandle">@drawable/tu_text_select_handle_middle</item>
        <item name="android:textSelectHandleLeft">@drawable/tu_text_select_handle_left</item>
        <item name="android:textSelectHandleRight">@drawable/tu_text_select_handle_right</item>

        <!-- 文本选中框高亮：显式固定为 M3 高亮色（MD3 配色），避免个别版本回落到原生高亮 -->
        <item name="android:textColorHighlight">@color/m3_highlighted_text</item>
    </style>

    <!-- M3 Search bar 的配色：图标/文字取 App 中性色板（不走基线紫调），只作用于搜索栏 -->
    <style name="ThemeOverlay.TransitU.Search" parent="">
        <item name="colorSurfaceContainerHigh">@color/search_container</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_2</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOutline">@color/line</item>
    </style>

    <!-- 页面标题栏的「←」返回按钮：40dp 圆形点按区（标题栏 paddingStart 相应减为 11dp，箭头仍对齐页面边距） -->
    <style name="BackButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_back_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
